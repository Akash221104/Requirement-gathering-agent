# LiveKit Cloud Configuration
# Retrieve these credentials from your LiveKit Cloud dashboard (https://cloud.livekit.io)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=wss://your-project.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Deepgram Realtime STT Configuration
# Retrieve your API key from Deepgram Console (https://console.deepgram.com)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# LLM Providers Configuration (Phase 3)
# Retrieve your Groq API key (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
# Retrieve your OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
